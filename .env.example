# ==============================================================
# ENTERPRISE AI FINOPS GATEWAY - PRODUCTION CONFIGURATION
# ==============================================================

# 1. Gateway Server
PORT=8080
DASHBOARD_PORT=3000

# 2. Upstream Inference Provider Target
# Options:
# - OpenAI:     https://api.openai.com
# - OpenRouter: https://openrouter.ai/api/v1
# - Anthropic:  https://api.anthropic.com
# - Local vLLM: http://localhost:8000/v1
UPSTREAM_URL=https://openrouter.ai/api/v1

# Master API Key (Optional: if set, Gateway injects this key for all downstream agents)
UPSTREAM_API_KEY=sk-or-v1-your-real-openrouter-or-openai-key-here

# 3. Redis State & Quota Cluster
REDIS_ADDR=localhost:6379
REDIS_PASS=

# 4. ML Sidecar Service
ML_SIDECAR_URL=http://localhost:8000

# 5. PostgreSQL Warehouse (Optional)
POSTGRES_DSN=postgres://finops:finops_password@localhost:5432/finops_db?sslmode=disable
